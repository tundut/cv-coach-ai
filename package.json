{
  "name": "cv-coach-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CV Coach AI - Intelligent Resume Analysis and Career Assistant Platform",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend",
    "packages/infra"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace @cv-coach/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json,md}\"",
    "dev:frontend": "npm run dev --workspace @cv-coach/frontend",
    "dev:backend": "npm run dev --workspace @cv-coach/backend",
    "deploy:frontend": "bash scripts/deploy-frontend.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
