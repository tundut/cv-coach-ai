# Application
APP_VERSION=0.1.0
STAGE=dev

# AWS
AWS_REGION=ap-southeast-1

# Storage + Database (từ CDK outputs sau khi deploy)
RESUMES_BUCKET=
APP_TABLE_NAME=

# Cognito (từ CDK outputs)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Async processing (từ CDK outputs)
ANALYSIS_QUEUE_URL=
# Đặt true để xử lý phân tích inline khi dev local (không cần SQS)
LOCAL_INLINE_PROCESSING=false

# ─── AI Provider ─────────────────────────────────
# Chuyển provider bằng cách đổi biến này: mock | openai | bedrock
#   mock    = dữ liệu giả, không cần API key (dev/test)
#   openai  = gọi OpenAI thật
#   bedrock = gọi Amazon Bedrock (cần model access + quyền bedrock:InvokeModel)
AI_PROVIDER=mock

# OpenAI — dùng khi AI_PROVIDER=openai (local dùng key này; prod đọc từ Secrets Manager)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Bedrock — dùng khi AI_PROVIDER=bedrock
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# BEDROCK_REGION=us-east-1   # mặc định dùng AWS_REGION nếu bỏ trống
